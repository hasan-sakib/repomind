ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://repomind:repomind@localhost:5432/repomind

# GitHub OAuth App (create one at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Session / auth token signing — generate with: openssl rand -hex 32
JWT_SECRET=

# AI provider
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
