# Complete reference for every variable app/core/config.py reads. Copy to
# .env (gitignored) and fill in the blanks — every field below with no
# default value shown is required; everything else already has the
# default in app/core/config.py and only needs to be set to override it.
# See docs/deployment/ci-cd.md for what each deployment environment
# (development/staging/production) actually sets these to, and which of
# them are real secrets vs. plain configuration.

# development | test | production — "test" is set by tests/conftest.py
# itself, never here. Gates Swagger UI (/docs, off in production) and
# cookie `Secure` (on in production) — see app/core/config.py.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# JSON array of web origins allowed to call this API (CORS). One entry
# per environment this API serves — a staging API should list only its
# own staging frontend origin, not production's.
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://repomind:repomind@localhost:5432/repomind

# Public URL of the frontend — used to build redirect/email links.
FRONTEND_URL=http://localhost:3000

# GitHub OAuth App — login only (create one at https://github.com/settings/developers).
# Separate from the GitHub App below — see docs/architecture/0002-auth-and-multi-tenancy.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App — repository access + webhooks only, never login (create one at
# https://github.com/settings/apps/new). See docs/architecture/0003-github-integration.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the full PEM private key, including BEGIN/END lines.
GITHUB_APP_PRIVATE_KEY=
# Required for the webhook route to accept anything — an unset/empty value
# fails closed (verify_signature always returns False) rather than falling
# back to signing with a known empty key. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Session / auth token signing — required, at least 32 characters (the app
# refuses to start otherwise — see app/core/config.py). Generate with:
# openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Blocks login until the account's email is verified. Off by default — no
# real email transport is configured yet (app/integrations/email); turning
# this on before wiring one up would lock every user out. See
# docs/architecture/security.md for why ConsoleEmailSender (the only
# EmailSender today) refuses to run when ENVIRONMENT=production.
REQUIRE_EMAIL_VERIFICATION=false

# AI provider — chat/completion. "ollama" is free and local (no API key;
# `ollama serve` running + the model pulled via `ollama pull <model>`).
# "anthropic" is the paid, hosted alternative — see docs/architecture/
# 0005-ai-rag-engine.md for the cost/quality tradeoff.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Embeddings + reranking — see docs/architecture/0004-codebase-indexing.md
# and 0005-ai-rag-engine.md. Voyage AI's free tier (~200M tokens each) is
# generous enough that this stays on Voyage even when AI_PROVIDER=ollama;
# create a free key at https://dash.voyageai.com.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# voyage-code-3 supports Matryoshka output truncation (256/512/1024/2048).
# 1024 balances retrieval quality against pgvector index size/build time.
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=voyage
VOYAGE_RERANK_MODEL=rerank-2.5

# Background job queue (indexing, re-indexing, embeddings) — see
# docs/architecture/0004-codebase-indexing.md. Requires `docker compose up`
# (redis service) locally, or any reachable Redis instance (Upstash in
# production — see docs/deployment/ci-cd.md).
REDIS_URL=redis://localhost:6379

# Per-IP rate limits (app/core/rate_limit.py) on the unauthenticated
# endpoints most attractive to brute-force/abuse — credential stuffing,
# account enumeration via registration, password-reset email bombing. See
# docs/architecture/security.md. Defaults are reasonable for a small/
# medium deployment; tune per environment if needed.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_EMAIL_VERIFY_PER_MINUTE=5

# Indexing pipeline tunables.
INDEXING_MAX_FILE_SIZE_BYTES=500000
INDEXING_MAX_FILES_PER_REPOSITORY=3000
INDEXING_MAX_CHUNK_LINES=200

# RAG pipeline tunables (app/retrieval/graph.py).
RAG_VECTOR_CANDIDATES=24
RAG_CONTEXT_CHUNKS=8
RAG_DEPENDENCY_LIMIT=12
RAG_GIT_HISTORY_LIMIT=5
RAG_MAX_CONTEXT_CHARS=24000

# PR analysis tunables (app/pr_analysis/, app/services/pr_analysis_service.py).
PR_ANALYSIS_MAX_PATCH_CHARS_PER_FILE=2000
PR_ANALYSIS_MAX_OUTPUT_TOKENS=3000

# Onboarding guide tunables (app/onboarding/, app/services/onboarding_service.py).
ONBOARDING_MAX_OUTPUT_TOKENS=4000

# Analytics tunables (app/analytics/, app/services/analytics_service.py).
ANALYTICS_STALE_ISSUE_DAYS=30
ANALYTICS_TOP_HOTSPOTS=15

# Billing provider — see app/billing/provider.py. "null" (the only option
# today) means no real subscription billing is wired up; plan changes
# happen directly via organization_service.set_plan.
BILLING_PROVIDER=null
